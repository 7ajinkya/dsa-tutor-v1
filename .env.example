# ---- MySQL (required) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=dsa_tutor_v1

# ---- AI provider ----
# builtin  : offline semantic engine authored by AutoClaw (default, no API needed)
# openai   : any OpenAI-compatible external LLM API (backward compatible)
# hybrid   : external first, automatic fallback to builtin on failure/invalid output
#            (recommended with free tiers: 429 rate limits fall back to the offline engine)
#
# KEYLESS LOCAL OPTION (Ollama):
#   AI_PROVIDER=hybrid
#   AI_MODEL=qwen2.5:3b            (or qwen2.5:7b if RAM allows)
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=local-only      (value ignored by Ollama)
#
# FREE HOSTED OPTIONS (fast + strong, no card needed):
#   Groq (fastest free inference, ~30 req/min, ~14.4k req/day - key: console.groq.com)
#   AI_PROVIDER=hybrid
#   AI_MODEL=openai/gpt-oss-120b
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#
#   Gemini (free tier ~5-15 req/min - key: aistudio.google.com)
#   AI_PROVIDER=hybrid
#   AI_MODEL=gemini-2.5-flash
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
#   Generic OpenAI:
#   AI_PROVIDER=hybrid
#   AI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=builtin
AI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_CALLS_PER_SESSION=60
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
# free-tier safeguard: max external LLM requests per day (0 = unlimited).
# Groq free tier = 1,000 req/day for gpt-oss-120b (check console.groq.com/docs/rate-limits for your account).
AI_DAILY_REQUEST_LIMIT=1000
# where the counter lives (one JSON file, auto-resets each day)
AI_USAGE_FILE=

# ---- Learning engine tuning ----
HINT_LIMIT=4
DAILY_TARGET_UNITS=4

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=logs

# amendment: raw AI request/response bodies logged only when true (structured log always on)
AI_LOG_RAW_REQUESTS=false
